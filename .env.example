# Chave publica do StaticForms usada pelo formulario de contato.
# Copie para .env (que nao vai para o git) e cadastre o mesmo valor
# em Settings > Secrets and variables > Actions com o nome PUBLIC_STATICFORMS_KEY.
PUBLIC_STATICFORMS_KEY=

# Endereço do Cloudflare Worker que recebe as inscrições da newsletter.
# Veja worker/README.md para criar o Worker e pegar esta URL.
# Vazio desativa o formulário, que passa a avisar que falta configurar.
PUBLIC_NEWSLETTER_ENDPOINT=https://newsletter.SEU-SUBDOMINIO.workers.dev

# Só para rodar scripts/brevo-ids.mjs de vez em quando. NÃO é usada no build:
# a chave de verdade vive como secret do Cloudflare Worker, nunca no site.
# BREVO_API_KEY=
