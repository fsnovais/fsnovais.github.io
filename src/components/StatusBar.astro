---
/*
  Barra de status, fixa no rodapé da tela, no espírito das barras do tmux e do
  vim: à esquerda quem você é e onde está; à direita os controles da sessão.

  Ela concentra busca, tema e idioma. O cabeçalho fica só com a moldura da
  janela e as abas, que é o que ele deveria fazer.
*/
import Search from './Search.astro';
import ThemePicker from './ThemePicker.astro';
import LangToggle from './LangToggle.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { caminho = '~', langAlternate } = Astro.props;
---

<div class="status" role="contentinfo" aria-label={t('status.session')}>
  <span class="usuario">felipe@log</span>
  <span class="caminho" title={caminho}>{caminho}</span>

  <span class="dica" aria-hidden="true">{t('status.hint')}</span>

  <div class="controles">
    <Search />

    <ThemePicker />
    <LangToggle destinoAlternativo={langAlternate} />
  </div>
</div>

<style>
  .status {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 70;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--status-h);
    padding-right: var(--space-2);
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
  }

  /* bloco invertido, como o indicador de modo de um editor */
  .usuario {
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding-inline: var(--space-3);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    white-space: nowrap;
  }

  .caminho {
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dica {
    margin-left: auto;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .controles {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  @media (max-width: 60rem) {
    .dica {
      display: none;
    }
    .controles {
      margin-left: auto;
    }
  }

  @media (max-width: 30rem) {
    /* na tela estreita o caminho sai e sobram só os controles */
    .caminho {
      display: none;
    }
  }
</style>
