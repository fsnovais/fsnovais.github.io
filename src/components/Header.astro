---
/*
  Cabeçalho em duas faixas, como a moldura de um emulador de terminal:

    faixa 1: barra de título da janela, com a marca, o caminho e os três quadros
    faixa 2: fila de abas numeradas, no estilo do tmux, mais os links externos

  O menu sanduíche saiu. Quatro abas cabem numa fila rolável no celular, e uma
  fila rolável é mais rápida de usar do que um menu que abre e fecha.
*/
import { site } from '../data/site.js';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils.js';
import { rota } from '../i18n/routes.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const inicio = localizedPath(lang, '/');
const { caminho = '~' } = Astro.props;

// a aba ativa sai do próprio endereço, sem depender de JS
const atual = Astro.url.pathname.replace(/\/+$/, '') || '/';
const abas = site.nav.map((item, i) => {
  const href = rota(item.rota, lang);
  const limpo = href.replace(/\/+$/, '') || '/';
  return {
    numero: i + 1,
    href,
    rotulo: t(item.chave),
    ativa: atual === limpo || atual.startsWith(`${limpo}/`),
  };
});
---

<header class="janela" data-header>
  <div class="barra">
    <div class="container barra-inner">
      <a class="marca" href={inicio}>
        <span class="marca-selo phos" aria-hidden="true">{site.mark}</span>
        <span class="marca-nome">{site.brand}</span>
      </a>

      <p class="titulo-janela" aria-hidden="true">
        <span class="titulo-usuario">felipe@log</span>:<span class="titulo-caminho"
          >{caminho}</span
        >
      </p>

      <div class="quadros" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
    </div>
  </div>

  <nav class="abas" aria-label={t('nav.primary')}>
    <div class="container abas-inner">
      <ul class="aba-lista">
        {
          abas.map((aba) => (
            <li>
              <a
                href={aba.href}
                class="aba"
                aria-current={aba.ativa ? 'page' : undefined}
                data-atalho={aba.numero}
              >
                <span class="aba-num" aria-hidden="true">
                  {aba.numero}
                </span>
                {aba.rotulo}
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="externos">
        {
          site.socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                {s.label.toLowerCase()}
                <span aria-hidden="true"> ↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  .janela {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  /* ---------- faixa 1: barra de título ---------- */
  .barra {
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }

  .barra-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: var(--header-h);
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: var(--track-tight);
  }

  .marca:hover {
    color: var(--accent);
  }

  .marca-selo {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: var(--step--2);
    font-weight: 700;
  }

  .marca-nome {
    font-size: var(--step-0);
  }

  /* o título fica centrado na janela, como em qualquer emulador */
  .titulo-janela {
    flex: 1;
    text-align: center;
    font-size: var(--step--2);
    color: var(--text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .titulo-usuario {
    color: var(--text-muted);
  }

  .titulo-caminho {
    color: var(--accent);
  }

  .quadros {
    display: flex;
    gap: 5px;
  }

  .quadros span {
    width: 9px;
    height: 9px;
    border: 1px solid var(--border-strong);
  }

  /* ---------- faixa 2: abas ---------- */
  .abas-inner {
    display: flex;
    align-items: stretch;
    gap: var(--space-5);
    height: var(--tabs-h);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .abas-inner::-webkit-scrollbar {
    display: none;
  }

  .aba-lista,
  .externos {
    display: flex;
    align-items: stretch;
    list-style: none;
    padding: 0;
  }

  .aba-lista {
    gap: 1px;
  }

  .aba {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 100%;
    padding-inline: var(--space-4);
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--step--1);
    white-space: nowrap;
    background: var(--bg-alt);
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .aba-num {
    color: var(--text-faint);
    font-size: var(--step--2);
  }

  .aba:hover {
    background: var(--surface-hover);
    color: var(--text);
  }

  /* aba ativa: invertida, como a janela em foco no tmux */
  .aba[aria-current='page'] {
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .aba[aria-current='page'] .aba-num {
    color: var(--on-accent);
    opacity: 0.7;
  }

  .externos {
    margin-left: auto;
    align-items: stretch;
    gap: var(--space-3);
    padding-left: var(--space-4);
  }

  .externos a {
    display: inline-flex;
    align-items: center;
    /* a fila de abas tem 34px: o link ocupa ela inteira e vira um alvo de
       toque confortável, em vez de uma linha de 14px */
    height: 100%;
    padding-inline: var(--space-1);
    color: var(--text-faint);
    text-decoration: none;
    font-size: var(--step--2);
    white-space: nowrap;
  }

  .externos a:hover {
    color: var(--accent);
  }

  @media (max-width: 48rem) {
    .titulo-janela,
    .quadros {
      display: none;
    }

    .marca {
      margin-right: auto;
    }

    .externos {
      display: none;
    }

    .abas-inner {
      padding-inline: var(--space-2);
    }
  }
</style>

<script>
  /*
    Atalhos 1 a 4 pulam entre as abas, como num terminal com várias janelas.
    Só valem fora de campo de texto e sem tecla modificadora, para não roubar
    combinações do navegador nem atrapalhar quem está digitando na busca.
  */
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const foco = document.activeElement;
    if (foco && ['INPUT', 'TEXTAREA', 'SELECT'].includes(foco.tagName)) return;
    if (document.querySelector('dialog[open]')) return;
    if (!/^[1-9]$/.test(e.key)) return;

    const alvo = document.querySelector(`[data-atalho="${e.key}"]`);
    if (alvo) {
      e.preventDefault();
      alvo.click();
    }
  });
</script>
