---
import { Image } from 'astro:assets';
import { projects, categories } from '../data/projects.js';
import { getLangFromUrl, useTranslations, pick } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// numa página própria o título é h1; embutido numa página maior seria h2
const { titulo = 'h2' } = Astro.props;
const Titulo = titulo;
// o card fica um nível abaixo do título da seção, sem pular degrau
const TituloCard = titulo === 'h1' ? 'h2' : 'h3';

const counts = Object.fromEntries(
  categories.map((c) => [c.id, projects.filter((p) => p.category === c.id).length])
);
---

<section class="section" id="projetos">
  <div class="container">
    <div class="section-head">
      <p class="comando">
        <span class="prompt" aria-hidden="true">$</span> ls ~/projetos{' '}
        <span class="contagem" aria-hidden="true">({projects.length})</span>
      </p>
      <Titulo class="phos">{t('projects.title')}</Titulo>
      <p class="intro">{t('projects.intro')}</p>
    </div>

    <div class="filters" role="group" aria-label={t('projects.filterLabel')}>
      <span class="filters-flag" aria-hidden="true">--filter</span>
      <button class="filter" type="button" data-filter="todos" aria-pressed="true">
        {t('projects.all')} <span class="filter-count tabular">{projects.length}</span>
      </button>
      {
        categories.map((c) => (
          <button class="filter" type="button" data-filter={c.id} aria-pressed="false">
            {t(`projects.cat.${c.id}`)} <span class="filter-count tabular">{counts[c.id]}</span>
          </button>
        ))
      }
    </div>

    <p
      class="visually-hidden"
      role="status"
      data-filter-status
      data-rotulo-singular={t('projects.shown')}
      data-rotulo-plural={t('projects.shownPlural')}
    ></p>

    <ul class="project-grid" data-project-grid>
      {
        projects.map((p) => (
          <li class="project" data-category={p.category}>
            <a class="project-link" href={p.url} target="_blank" rel="noopener noreferrer">
              <div class="project-bar">
                <span class="project-cat">{t(`projects.cat.${p.category}`)}</span>
                <span class="project-abrir" aria-hidden="true">open ↗</span>
              </div>
              <div class="project-media">
                {p.video ? (
                  <video
                    poster={p.image.src}
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                  >
                    {p.video.map((s) => (
                      <source src={s.src} type={s.type} />
                    ))}
                  </video>
                ) : (
                  <Image src={p.image} alt="" width={640} height={400} loading="lazy" />
                )}
              </div>
              <div class="project-body">
                <TituloCard>{p.title}</TituloCard>
                <p>{pick(p.description, lang)}</p>
                <ul class="project-tags">
                  {p.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .comando {
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .contagem {
    color: var(--border-strong);
  }

  h1,
  h2 {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }

  .intro {
    font-family: var(--font-prose);
    font-size: var(--step-1);
    line-height: var(--leading-prose);
    color: var(--text-muted);
    max-width: var(--reading);
  }

  /* filtros como bandeiras de comando, não como pílulas */
  .filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .filters-flag {
    font-size: var(--step--2);
    color: var(--border-strong);
    margin-right: var(--space-1);
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border-ui);
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    cursor: pointer;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .filter:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .filter[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .filter-count {
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .filter[aria-pressed='true'] .filter-count {
    color: var(--on-accent);
    opacity: 0.75;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .project[hidden] {
    display: none;
  }

  .project-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }

  .project-link:hover {
    border-color: var(--accent);
    color: inherit;
  }

  /* barra de título do card, no mesmo espírito da janela do site */
  .project-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
    font-size: var(--step--2);
  }

  .project-cat {
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-abrir {
    color: var(--text-faint);
  }

  .project-link:hover .project-abrir {
    color: var(--accent);
  }

  .project-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }

  .project-media :global(img),
  .project-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    flex-grow: 1;
  }

  .project-body h2,
  .project-body h3 {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: var(--track-tight);
  }

  .project-link:hover h2,
  .project-link:hover h3 {
    color: var(--accent);
  }

  .project-body > p {
    flex-grow: 1;
    font-family: var(--font-prose);
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
  }

  .project-tags li {
    font-size: var(--step--2);
    color: var(--text-faint);
    border: 1px solid var(--border);
    padding: 0 var(--space-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-media video {
      display: none;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll('[data-filter]');
  const items = document.querySelectorAll('[data-project-grid] > .project');
  const status = document.querySelector('[data-filter-status]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b === btn))
      );

      let visiveis = 0;
      items.forEach((item) => {
        const match = filter === 'todos' || item.getAttribute('data-category') === filter;
        item.hidden = !match;
        if (match) visiveis += 1;
      });

      if (status) {
        const rotulo =
          visiveis === 1
            ? status.dataset.rotuloSingular
            : status.dataset.rotuloPlural;
        status.textContent = `${visiveis} ${rotulo}`;
      }
    });
  });
</script>
