---
/*
  Busca no estilo fzf: prompt no topo, resultados abaixo, linha de status com a
  contagem no rodapé da caixa. Índice estático, sem biblioteca.
*/
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// mesmo arquivo gerado por src/pages/search.json.js (pt) e src/pages/en/search.json.js
const indexUrl = localizedPath(lang, '/search.json');

const strings = {
  empty: t('search.empty'),
  sectionBlog: t('posts.section.blog'),
  sectionDevlog: t('posts.section.devlog'),
  onlyPt: t('posts.onlyPortuguese'),
  onlyEn: t('posts.onlyEnglish'),
};
---

<button
  type="button"
  class="gatilho"
  data-search-open
  aria-haspopup="dialog"
  title={t('search.buttonAria')}
>
  <span aria-hidden="true">/</span>
  <span class="visually-hidden">{t('search.buttonAria')}</span>
</button>

<dialog class="caixa" data-search-dialog aria-label={t('search.buttonAria')}>
  <div class="linha-prompt">
    <span class="prompt" aria-hidden="true">&gt;</span>
    <input
      type="search"
      data-search-input
      placeholder={t('search.placeholder')}
      aria-label={t('search.placeholder')}
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
    />
    <button type="button" class="fechar" data-search-close>
      <span aria-hidden="true">esc</span>
      <span class="visually-hidden">{t('search.close')}</span>
    </button>
  </div>

  <ul class="resultados" data-search-results></ul>
  <p class="vazio" data-search-empty hidden></p>

  <p class="rodape-caixa">
    <span class="contagem tabular" data-search-count>0/0</span>
    <span class="dica" data-search-hint>{t('search.hint')}</span>
  </p>
</dialog>

<style>
  .gatilho {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 1px solid var(--border-ui);
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1;
    cursor: pointer;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  .gatilho:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .caixa {
    margin: 8vh auto auto;
    padding: 0;
    width: min(94vw, 42rem);
    max-height: 76vh;
    border: 1px solid var(--border-ui);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .caixa:not([open]) {
    display: none;
  }

  .caixa::backdrop {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
  }

  .linha-prompt {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
    background: var(--bg-alt);
  }

  .linha-prompt .prompt {
    font-weight: 700;
  }

  .linha-prompt input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: var(--step-1);
  }

  .linha-prompt input:focus {
    outline: none;
    background: transparent;
    border: 0;
  }

  .linha-prompt input::-webkit-search-cancel-button {
    display: none;
  }

  .fechar {
    flex: none;
    padding: 2px var(--space-2);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    cursor: pointer;
  }

  .fechar:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .resultados {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    flex: 1;
  }

  .resultados:empty {
    display: none;
  }

  .vazio {
    padding: var(--space-4);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  /* o conteúdo é montado por JS: precisa de :global para o Astro não podar */
  .resultados :global(a) {
    display: grid;
    grid-template-columns: 1.5ch auto 1fr;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-2) var(--space-4);
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
  }

  /* a marca ▌ acende só na linha ativa, como o cursor de uma lista de terminal */
  .resultados :global(.marca) {
    color: transparent;
  }

  .resultados :global(li.is-active a),
  .resultados :global(a:hover) {
    background: var(--accent-wash);
  }

  .resultados :global(li.is-active .marca),
  .resultados :global(a:hover .marca) {
    color: var(--accent);
  }

  .resultados :global(.secao) {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .resultados :global(.titulo) {
    font-size: var(--step-0);
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .resultados :global(.detalhe) {
    grid-column: 3;
    display: flex;
    gap: var(--space-3);
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .resultados :global(.selo) {
    border: 1px solid var(--border);
    padding: 0 var(--space-1);
  }

  .resultados :global(mark) {
    background: var(--accent);
    color: var(--on-accent);
  }

  .rodape-caixa {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .contagem {
    color: var(--accent);
  }

  .dica {
    margin-left: auto;
  }

  @media (max-width: 40rem) {
    .caixa {
      margin-top: 4vh;
      max-height: 86vh;
    }
    .dica {
      display: none;
    }
  }
</style>

<script define:vars={{ indexUrl, strings }}>
  const openBtn = document.querySelector('[data-search-open]');
  const dialog = document.querySelector('[data-search-dialog]');
  const input = document.querySelector('[data-search-input]');
  const closeBtn = document.querySelector('[data-search-close]');
  const resultsEl = document.querySelector('[data-search-results]');
  const emptyEl = document.querySelector('[data-search-empty]');
  const countEl = document.querySelector('[data-search-count]');

  if (openBtn && dialog && input && resultsEl && typeof dialog.showModal === 'function') {
    let indice = null;
    let indicePromise = null;
    let ativo = -1;
    let debounceTimer;

    function carregarIndice() {
      if (indicePromise) return indicePromise;
      indicePromise = fetch(indexUrl)
        .then((r) => (r.ok ? r.json() : []))
        .then((dados) => {
          indice = Array.isArray(dados) ? dados : [];
          return indice;
        })
        .catch(() => {
          indice = [];
          return indice;
        });
      return indicePromise;
    }

    // remove acento para "cafe" achar "café": comparação simples, sem lib
    function normalizar(texto) {
      return (texto || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();
    }

    function pontuar(item, consulta) {
      const titulo = normalizar(item.titulo);
      const descricao = normalizar(item.descricao);
      const tags = (item.tags || []).map(normalizar);

      if (titulo === consulta) return 100;
      if (titulo.startsWith(consulta)) return 80;
      if (titulo.includes(consulta)) return 60;
      if (tags.some((tg) => tg.includes(consulta))) return 40;
      if (descricao.includes(consulta)) return 20;
      return 0;
    }

    function destacar(texto, consulta) {
      if (!consulta) return texto;
      const alvo = normalizar(texto);
      const i = alvo.indexOf(consulta);
      if (i === -1) return texto;
      return (
        texto.slice(0, i) +
        '<mark>' +
        texto.slice(i, i + consulta.length) +
        '</mark>' +
        texto.slice(i + consulta.length)
      );
    }

    function atualizarContagem(total) {
      if (countEl) countEl.textContent = `${total === 0 ? 0 : ativo + 1}/${total}`;
    }

    function atualizarAtivo(itens) {
      itens.forEach((a, i) => a.closest('li').classList.toggle('is-active', i === ativo));
      itens[ativo]?.scrollIntoView({ block: 'nearest' });
      atualizarContagem(itens.length);
    }

    function renderizar(itens, consulta, exibicao) {
      resultsEl.innerHTML = '';
      ativo = -1;

      if (!exibicao) {
        emptyEl.hidden = true;
        atualizarContagem(0);
        return;
      }

      if (itens.length === 0) {
        emptyEl.hidden = false;
        emptyEl.textContent = strings.empty.replace('{query}', exibicao);
        atualizarContagem(0);
        return;
      }
      emptyEl.hidden = true;

      const mostrados = itens.slice(0, 12);
      mostrados.forEach((item) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = item.url;

        const secaoTexto = item.secao === 'blog' ? strings.sectionBlog : strings.sectionDevlog;
        const selo = !item.traduzido
          ? `<span class="selo">${item.idioma === 'pt' ? strings.onlyPt : strings.onlyEn}</span>`
          : '';

        a.innerHTML =
          `<span class="marca" aria-hidden="true">&#9612;</span>` +
          `<span class="secao">${secaoTexto}</span>` +
          `<span class="titulo">${destacar(item.titulo, consulta)}</span>` +
          `<span class="detalhe"><time>${item.data}</time>${selo}</span>`;

        li.appendChild(a);
        resultsEl.appendChild(li);
      });

      // a primeira linha já vem marcada: ↵ abre o resultado mais provável
      ativo = 0;
      atualizarAtivo([...resultsEl.querySelectorAll('a')]);
    }

    async function executarBusca() {
      const exibicao = input.value.trim();
      const consulta = normalizar(exibicao);
      if (!indice) await carregarIndice();

      if (!consulta) {
        renderizar([], consulta, exibicao);
        return;
      }

      const encontrados = indice
        .map((item) => ({ item, pontos: pontuar(item, consulta) }))
        .filter((x) => x.pontos > 0)
        .sort((a, b) => b.pontos - a.pontos || new Date(b.item.data) - new Date(a.item.data))
        .map((x) => x.item);

      renderizar(encontrados, consulta, exibicao);
    }

    function abrir() {
      carregarIndice();
      input.value = '';
      renderizar([], '', '');
      dialog.showModal();
      requestAnimationFrame(() => input.focus());
    }

    openBtn.addEventListener('click', abrir);
    closeBtn?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => openBtn.focus());

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(executarBusca, 80);
    });

    input.addEventListener('keydown', (e) => {
      const itens = [...resultsEl.querySelectorAll('a')];
      if (!itens.length) return;
      // ctrl+n e ctrl+p também andam na lista, como no fzf
      const desce = e.key === 'ArrowDown' || (e.ctrlKey && e.key === 'n');
      const sobe = e.key === 'ArrowUp' || (e.ctrlKey && e.key === 'p');
      if (desce) {
        e.preventDefault();
        ativo = Math.min(ativo + 1, itens.length - 1);
        atualizarAtivo(itens);
      } else if (sobe) {
        e.preventDefault();
        ativo = Math.max(ativo - 1, 0);
        atualizarAtivo(itens);
      } else if (e.key === 'Enter' && ativo >= 0) {
        e.preventDefault();
        itens[ativo].click();
      }
    });

    // atalho global: "/" ou cmd+k/ctrl+k abrem a busca de qualquer página
    document.addEventListener('keydown', (e) => {
      const emCampo = ['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName);
      const atalho =
        (e.key === '/' && !emCampo) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k');
      if (atalho && !dialog.open) {
        e.preventDefault();
        abrir();
      }
    });
  }
</script>
