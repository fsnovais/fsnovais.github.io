---
/*
  Rodapé como a última saída da sessão. Os controles (tema, idioma, busca)
  ficam na barra de status; aqui sobram só os endereços que levam para fora.
*/
import { site } from '../data/site.js';
import { getLangFromUrl, useTranslations } from '../i18n/utils.js';
import { rota } from '../i18n/routes.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const ano = new Date().getFullYear();

const links = [
  ...site.socials.map((s) => ({ rotulo: s.label.toLowerCase(), url: s.url, externo: true })),
  { rotulo: t('privacy.link').toLowerCase(), url: rota('privacidade', lang) },
  ...(site.cv ? [{ rotulo: t('footer.cv').toLowerCase(), url: site.cv, externo: true }] : []),
  ...(site.email ? [{ rotulo: 'email', url: `mailto:${site.email}` }] : []),
  { rotulo: 'rss/blog', url: `/rss/${lang}/blog.xml` },
  { rotulo: 'rss/devlog', url: `/rss/${lang}/devlog.xml` },
];
---

<footer class="rodape">
  <div class="container rodape-inner">
    <p class="comando">
      <span class="prompt" aria-hidden="true">$</span> cat ~/.signature
    </p>

    <div class="saida">
      <p class="linha">
        <span class="selo phos" aria-hidden="true">{site.mark}</span>
        <span class="nome">{site.brand}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span class="tagline">{t('site.tagline')}</span>
      </p>

      <nav aria-label={t('nav.footer')}>
        <ul class="links">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.url}
                  target={l.externo ? '_blank' : undefined}
                  rel={l.externo ? 'noopener noreferrer' : undefined}
                >
                  {l.rotulo}
                  {l.externo && <span aria-hidden="true"> ↗</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="nota">
        <span>&copy; {ano} {site.name}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span>{t('footer.builtWith')}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .rodape {
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
    padding-block: var(--space-5) var(--space-6);
  }

  .comando {
    font-size: var(--step--1);
    color: var(--text-faint);
    margin-bottom: var(--space-3);
  }

  .saida {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-left: var(--space-4);
    border-left: 1px solid var(--border);
  }

  .linha {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--step-0);
  }

  .selo {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: var(--step--2);
    font-weight: 700;
  }

  .nome {
    font-weight: 600;
    color: var(--text);
  }

  .tagline {
    color: var(--text-muted);
  }

  .sep {
    color: var(--border-strong);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    padding: 0;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--text-muted);
    font-size: var(--step--1);
    text-decoration: none;
    border-bottom: 1px dotted var(--border-strong);
  }

  .links a:hover {
    color: var(--on-accent);
    background: var(--accent);
    border-bottom-color: transparent;
  }

  .nota {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--step--2);
    color: var(--text-faint);
  }
</style>
