---
/* Listagem de posts no formato de uma saída de `ls`: data, nome, descrição. */
import { dataIso } from '../lib/posts.js';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/** itens: [{ post, lang, traduzido }] vindos de listarComTraducao */
const { itens, base } = Astro.props;
---

{
  itens.length === 0 ? (
    <p class="vazio">{t('posts.empty')}</p>
  ) : (
    <ul class="post-list">
      {itens.map(({ post, lang: langPost, traduzido }) => (
        <li>
          <a
            class="entrada"
            href={localizedPath(langPost, `${base}/${post.id}`)}
            lang={traduzido ? undefined : langPost}
          >
            {/* data em ISO, para alinhar em coluna como numa saída de ls */}
            <time class="col-data tabular" datetime={dataIso(post.data.date)}>
              {dataIso(post.data.date).slice(0, 10)}
            </time>
            <span class="col-titulo">
              {post.data.title}
              {post.data.draft && <span class="selo rascunho">{t('posts.draft')}</span>}
              {!traduzido && (
                <span class="selo">
                  {langPost === 'pt' ? t('posts.onlyPortuguese') : t('posts.onlyEnglish')}
                </span>
              )}
            </span>
            <span class="col-resumo">{post.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .post-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .post-list li {
    border-bottom: 1px solid var(--border);
  }

  .entrada {
    display: grid;
    grid-template-columns: 11ch 1fr;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-3) var(--space-2);
    color: inherit;
    text-decoration: none;
    transition: background var(--dur) var(--ease);
  }

  .entrada:hover {
    background: var(--accent-wash);
  }

  .col-data {
    font-size: var(--step--1);
    color: var(--text-faint);
    white-space: nowrap;
    padding-top: 0.15em;
  }

  .col-titulo {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--text);
    letter-spacing: var(--track-tight);
  }

  .entrada:hover .col-titulo {
    color: var(--accent);
  }

  .selo {
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text-faint);
    border: 1px solid var(--border);
    padding: 0 var(--space-1);
  }

  .rascunho {
    color: var(--accent);
    border-color: var(--accent);
  }

  .col-resumo {
    grid-column: 2;
    max-width: 72ch;
    font-family: var(--font-prose);
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  @media (max-width: 40rem) {
    .entrada {
      grid-template-columns: 1fr;
    }
    .col-resumo {
      grid-column: 1;
    }
  }

  .vazio {
    color: var(--text-muted);
    padding-block: var(--space-5);
    border-block: 1px solid var(--border);
  }
</style>
