---
/*
  O texto dos dois idiomas fica em src/i18n/about.js e sai do currículo em
  cv/curriculo.html. Ao mudar um, revise o outro.
*/
import { getLangFromUrl, useTranslations } from '../i18n/utils.js';
import { rota } from '../i18n/routes.js';
import { about } from '../i18n/about.js';
import Contact from '../components/Contact.astro';
import { site } from '../data/site.js';

// caminho do PDF em src/data/site.js; vazio esconde o botão
const CURRICULO = site.cv;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = about[lang];

// {blog}, {devlog} e {projetos} viram o endereço no idioma da página
function resolver(html) {
  return String(html)
    .replaceAll('{blog}', rota('blog', lang))
    .replaceAll('{devlog}', rota('devlog', lang))
    .replaceAll('{projetos}', rota('projetos', lang));
}
---

<section class="section">
  <div class="container sobre">
    <div class="section-head">
      <p class="comando">
        <span class="prompt" aria-hidden="true">$</span> cat ~/sobre.md
      </p>
      <h1 class="phos">Felipe Novais</h1>
    </div>

    <div class="prosa">
      <p class="destaque">{c.destaque}</p>

      {
        c.blocos.map((bloco) => (
          <>
            <h2>{bloco.titulo}</h2>
            {bloco.paragrafos.map((texto) => (
              <p class={texto.lacuna ? 'lacuna' : undefined} set:html={resolver(texto.html ?? texto)} />
            ))}
          </>
        ))
      }

      <div class="cta">
        <a class="btn btn-solid" href="#contato">{t('about.ctaContact')}</a>
        {
          CURRICULO && (
            <a class="btn" href={CURRICULO} target="_blank" rel="noopener noreferrer">
              {t('about.cv')}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<Contact />

<style>
  .sobre {
    max-width: var(--reading-box);
    margin-inline: auto;
  }

  .comando {
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  h1 {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }

  /* texto longo em sans, títulos em mono: mesma regra do artigo */
  .prosa {
    max-width: var(--reading);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    font-family: var(--font-prose);
  }

  .destaque {
    font-size: var(--step-1);
    color: var(--text);
    line-height: var(--leading-prose);
  }

  .prosa p {
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: var(--leading-prose);
  }

  .prosa :global(a:not(.btn)) {
    color: var(--link);
  }

  .prosa :global(a:not(.btn):hover) {
    background: var(--accent);
    color: var(--on-accent);
    text-decoration-color: transparent;
  }

  .prosa :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prosa h2 {
    font-family: var(--font-mono);
    font-size: var(--step-2);
    color: var(--text);
    margin-top: var(--space-4);
  }

  .prosa h2::before {
    content: '## ';
    color: var(--accent);
    font-weight: 400;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
</style>
