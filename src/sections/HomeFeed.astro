---
/*
  A home é a transcrição de uma sessão: uma sequência de comandos e saídas.
  Como a moldura de janela já é o cabeçalho do site, aqui não há terminal
  dentro de terminal; a página inteira é o terminal.
*/
import { listarComTraducao, dataIso } from '../lib/posts.js';
import { site } from '../data/site.js';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils.js';
import { rota } from '../i18n/routes.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const [blog, devlog] = await Promise.all([
  listarComTraducao('blog', lang),
  listarComTraducao('devlog', lang),
]);

// feed único: o que importa é a data, não a seção
const recentes = [
  ...blog.map((i) => ({ ...i, secao: 'blog' })),
  ...devlog.map((i) => ({ ...i, secao: 'devlog' })),
]
  .sort((a, b) => b.post.data.date.getTime() - a.post.data.date.getTime())
  .slice(0, 6);

// as frases trocam sozinhas; sem JS ou com prefers-reduced-motion, a primeira basta
const whoamiLinhas = t('home.whoami.lines').split('|');

const lede = t('home.lede')
  .replaceAll('{devlog}', rota('devlog', lang))
  .replaceAll('{blog}', rota('blog', lang))
  .replaceAll('{contato}', `${rota('sobre', lang)}#contato`);

const atalhos = [
  { nome: 'projetos/', titulo: t('nav.projects'), texto: t('home.projectsCard'), href: rota('projetos', lang) },
  { nome: 'sobre.md', titulo: t('nav.about'), texto: t('home.aboutCard'), href: rota('sobre', lang) },
  {
    nome: 'contato.sh',
    titulo: t('home.contactLabel'),
    texto: t('home.contactCard'),
    href: `${rota('sobre', lang)}#contato`,
  },
];
---

<section class="sessao">
  <div class="container">
    <p class="comando"><span class="prompt" aria-hidden="true">$</span> whoami</p>

    <div class="bloco-titulo">
      <h1 class="phos">{site.brand}</h1>
      <p class="assinatura">{site.name}</p>
      <p class="rotativa">
        <span class="seta" aria-hidden="true">&gt;</span>
        <span data-whoami-text>{whoamiLinhas[0]}</span><span
          class="cursor"
          aria-hidden="true"></span>
      </p>
    </div>

    <p class="comando"><span class="prompt" aria-hidden="true">$</span> cat README.md</p>
    <p class="lede" set:html={lede} />
  </div>
</section>

<section class="section feed">
  <div class="container">
    <div class="feed-head">
      <h2 class="comando">
        <span class="prompt" aria-hidden="true">$</span> ls -lt ~/log{' '}
        <span class="flag" aria-hidden="true">--limit {recentes.length}</span>
      </h2>
      <p class="arquivos">
        <a href={rota('blog', lang)}>{t('home.allBlog')}</a>
        <span aria-hidden="true">·</span>
        <a href={rota('devlog', lang)}>{t('home.allDevlog')}</a>
      </p>
    </div>

    {
      recentes.length === 0 ? (
        <p class="vazio">{t('posts.empty')}</p>
      ) : (
        <ul class="lista">
          {recentes.map(({ post, lang: langPost, traduzido, secao }) => (
            <li>
              <a
                class="entrada"
                href={localizedPath(langPost, `/${secao}/${post.id}`)}
                lang={traduzido ? undefined : langPost}
              >
                {/* data em ISO: numa listagem de terminal ela precisa alinhar
                    em coluna e não depender do idioma */}
                <time class="col-data tabular" datetime={dataIso(post.data.date)}>
                  {dataIso(post.data.date).slice(0, 10)}
                </time>
                <span class="col-secao">{t(`posts.section.${secao}`)}</span>
                <span class="col-titulo">
                  {post.data.title}
                  {!traduzido && (
                    <span class="selo">
                      {langPost === 'pt' ? t('posts.onlyPortuguese') : t('posts.onlyEnglish')}
                    </span>
                  )}
                </span>
                <span class="col-resumo">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<section class="section mais on-alt">
  <div class="container">
    <h2 class="comando"><span class="prompt" aria-hidden="true">$</span> ls ~/</h2>
    <ul class="atalhos">
      {
        atalhos.map((a) => (
          <li>
            <a class="panel" href={a.href}>
              <span class="panel-title">{a.nome}</span>
              <span class="atalho-titulo">{a.titulo}</span>
              <span class="atalho-texto">{a.texto}</span>
              <span class="atalho-seta" aria-hidden="true">
                cd {a.nome} →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ---------- sessão de abertura ---------- */
  .sessao {
    padding-block: var(--space-7) var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .comando {
    font-size: var(--step--1);
    color: var(--text-faint);
    letter-spacing: 0.02em;
  }

  .bloco-titulo {
    padding: var(--space-2) 0 var(--space-6);
  }

  .sessao h1 {
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .assinatura {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .rotativa {
    margin-top: var(--space-4);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--step-0);
    color: var(--text);
    min-height: 1.6em;
  }

  .rotativa .seta {
    color: var(--accent);
  }

  .rotativa [data-whoami-text] {
    transition: opacity 200ms var(--ease);
  }

  .lede {
    margin-top: var(--space-3);
    max-width: 66ch;
    font-family: var(--font-prose);
    font-size: var(--step-1);
    line-height: var(--leading-prose);
    color: var(--text-muted);
  }

  .lede :global(a) {
    color: var(--text);
    text-decoration-color: var(--accent);
  }

  .lede :global(a:hover) {
    background: var(--accent);
    color: var(--on-accent);
    text-decoration-color: transparent;
  }

  /* ---------- feed em formato ls ---------- */
  .feed-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .feed-head h2 {
    font-size: var(--step--1);
    font-weight: 400;
  }

  .flag {
    color: var(--border-strong);
  }

  .arquivos {
    display: flex;
    gap: var(--space-3);
    font-size: var(--step--2);
  }

  .arquivos a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--text-faint);
    text-decoration: none;
    border-bottom: 1px dotted var(--border-strong);
  }

  .arquivos a:hover {
    background: var(--accent);
    color: var(--on-accent);
    border-bottom-color: transparent;
  }

  .arquivos span {
    color: var(--border-strong);
  }

  .lista {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .lista li {
    border-bottom: 1px solid var(--border);
  }

  /*
    Cada post é uma linha de listagem: data, seção, nome, descrição.
    A linha inteira é o alvo do clique, e não só o título.
  */
  .entrada {
    display: grid;
    grid-template-columns: 11ch 9ch 1fr;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-3) var(--space-2);
    text-decoration: none;
    color: inherit;
    transition: background var(--dur) var(--ease);
  }

  .entrada:hover {
    background: var(--accent-wash);
  }

  .col-data {
    font-size: var(--step--1);
    color: var(--text-faint);
    white-space: nowrap;
  }

  .col-secao {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    align-self: center;
  }

  .col-titulo {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--text);
    letter-spacing: var(--track-tight);
  }

  .entrada:hover .col-titulo {
    color: var(--accent);
  }

  .selo {
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text-faint);
    border: 1px solid var(--border);
    padding: 0 var(--space-1);
  }

  .col-resumo {
    grid-column: 3;
    max-width: 72ch;
    font-family: var(--font-prose);
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  @media (max-width: 46rem) {
    .entrada {
      grid-template-columns: auto 1fr;
    }
    .col-titulo,
    .col-resumo {
      grid-column: 1 / -1;
    }
  }

  .vazio {
    color: var(--text-muted);
    padding-block: var(--space-5);
    border-block: 1px solid var(--border);
  }

  /* ---------- atalhos em painéis ---------- */
  .mais {
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
  }

  .mais h2 {
    font-size: var(--step--1);
    font-weight: 400;
    margin-bottom: var(--space-5);
  }

  .atalhos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  .atalhos a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    text-decoration: none;
    /*
      O painel fica transparente de propósito: o título encaixado na borda de
      cima é desenhado sobre o fundo da seção, e qualquer fundo próprio aqui
      criaria um degrau visível atrás dele.
    */
    background: transparent;
    transition: border-color var(--dur) var(--ease);
  }

  .atalhos a:hover {
    border-color: var(--accent);
  }

  .atalho-titulo {
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--text);
    letter-spacing: var(--track-tight);
  }

  .atalhos a:hover .atalho-titulo {
    color: var(--accent);
  }

  .atalho-texto {
    flex-grow: 1;
    font-family: var(--font-prose);
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  .atalho-seta {
    margin-top: var(--space-2);
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .atalhos a:hover .atalho-seta {
    color: var(--accent);
  }
</style>

<script define:vars={{ linhas: whoamiLinhas }}>
  // troca a frase do whoami a cada alguns segundos, como se alguém tivesse
  // digitado o comando de novo. Quem pediu menos movimento vê só a primeira.
  const saida = document.querySelector('[data-whoami-text]');
  const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (saida && linhas.length > 1 && !reduzido) {
    let indice = 0;
    setInterval(() => {
      indice = (indice + 1) % linhas.length;
      saida.style.opacity = '0';
      setTimeout(() => {
        saida.textContent = linhas[indice];
        saida.style.opacity = '1';
      }, 200);
    }, 4200);
  }
</script>
