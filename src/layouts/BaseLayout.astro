---
/*
  Duas famílias, cada uma com um trabalho:
    JetBrains Mono  -> a interface inteira, títulos e dados
    IBM Plex Sans   -> só o corpo dos textos longos

  Apenas os subsets latinos: evita baixar cirílico, grego e vietnamita à toa.
*/
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import StatusBar from '../components/StatusBar.astro';
import Footer from '../components/Footer.astro';
import { site, knowsAbout } from '../data/site.js';
import { localeTags, languages, defaultLang } from '../i18n/ui.js';
import {
  getLangFromUrl,
  useTranslations,
  localizedPath,
  stripLang,
  paginaNoIdioma,
} from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tags = localeTags[lang];

const {
  title = t('site.title'),
  description = t('site.description'),
  image = `/og/${lang}/index.png`,
  type = 'website',
  publishedAt,
  noindex = false,
  jsonLd,
  // um post sem tradução não anuncia par de idioma e manda o botão
  // para a listagem do outro idioma, em vez de uma página inexistente
  temParDeIdioma: temParProp,
  langAlternate,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href.replace(/\/$/, '') || site.url;
const ogImageUrl = new URL(image, site.url).href;

// rota sem prefixo, para montar os pares de idioma.
// A 404 não tem par por idioma, então não anuncia hreflang.
const rotaNeutra = stripLang(Astro.url.pathname);
const temParDeIdioma =
  !/^\/404(\.html)?\/?$/.test(rotaNeutra) && temParProp !== false;

// caminho no estilo shell: '/' vira '~', '/blog/post/' vira '~/blog/post'
const caminhoLimpo = rotaNeutra.replace(/\/+$/, '');
const caminho = caminhoLimpo === '' || caminhoLimpo === '/' ? '~' : `~${caminhoLimpo}`;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: t('site.role'),
  description: t('site.description'),
  sameAs: site.socials.map((s) => s.url),
  knowsAbout,
};
---

<!doctype html>
<html lang={tags.html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Aplica tema e CRT ANTES da primeira pintura. Sem isto, quem escolheu
      gruvbox veria um lampejo âmbar a cada navegação.
      Quem tinha 'dark' ou 'light' salvos da versão anterior do site é migrado
      para o tema equivalente, sem perder a escolha.
    -->
    <script is:inline>
      try {
        var temas = ['amber', 'green', 'gruvbox', 'nord', 'tokyo', 'paper'];
        var antigo = { dark: 'amber', light: 'paper' };
        var tema = localStorage.getItem('tema');
        if (antigo[tema]) {
          tema = antigo[tema];
          localStorage.setItem('tema', tema);
        }
        if (temas.indexOf(tema) > -1) {
          document.documentElement.setAttribute('data-theme', tema);
        }
        if (localStorage.getItem('crt') === 'off') {
          document.documentElement.setAttribute('data-crt', 'off');
        }
      } catch (e) {
        /* storage bloqueado: tema do sistema e CRT ligado */
      }
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    {
      temParDeIdioma && (
        <>
          {Object.keys(languages).map((l) => (
            <link
              rel="alternate"
              hreflang={localeTags[l].hreflang}
              href={new URL(paginaNoIdioma(Astro.url.pathname, lang, l), site.url).href}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={
              new URL(paginaNoIdioma(Astro.url.pathname, lang, defaultLang), site.url).href
            }
          />
        </>
      )
    }

    {/* SVG primeiro: navegador moderno usa ele e fica nítido em qualquer tela.
        O .ico cobre quem não suporta SVG. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b0e12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f0e7" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={tags.og} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t('blog.eyebrow')}, ${site.brand}`}
      href={`/rss/${lang}/blog.xml`}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t('devlog.eyebrow')}, ${site.brand}`}
      href={`/rss/${lang}/devlog.xml`}
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? personLd)} />
  </head>

  <body>
    <a class="skip-link" href="#conteudo">{t('nav.skip')}</a>
    <Header caminho={caminho} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <StatusBar caminho={caminho} langAlternate={langAlternate} />
  </body>
</html>
