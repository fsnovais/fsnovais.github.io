import { site } from '../../../data/site.js';
import { useTranslations } from '../../../i18n/utils.js';

const t = useTranslations('en');
---

<BaseLayout
  title={`${t('newsletter.confirmTitle')}, ${site.brand}`}
  description={t('newsletter.confirmText')}
  noindex
>
  <NewsletterConfirm />
</BaseLayout>
