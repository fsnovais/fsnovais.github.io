---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';
import ProjectsPage from '../sections/ProjectsPage.astro';
import { useTranslations } from '../i18n/utils.js';
const t = useTranslations('pt');
---

<BaseLayout
  title={`Projetos, ${site.brand}`}
  description={t('projects.intro')}
  image="/og/pt/projetos.png"
>
  <ProjectsPage />
</BaseLayout>
